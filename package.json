{
  "name": "pi-feats",
  "version": "0.1.3",
  "description": "A modular Pi package for profiles, sandboxing, remote access, applications, guardrails, skills, session management, observability, and web-based operations.",
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "pi-agent",
    "pi-extension",
    "ai-agent",
    "agent-framework",
    "agentic-ai",
    "sandbox",
    "nono",
    "guardrails",
    "webui",
    "agent-operations"
  ],
  "homepage": "https://github.com/rjaskonis/pi-feats#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rjaskonis/pi-feats.git"
  },
  "bugs": {
    "url": "https://github.com/rjaskonis/pi-feats/issues"
  },
  "files": [
    "extensions",
    "scripts",
    "skills",
    "README.md",
    "LICENSE",
    "assets"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:web": "cd extensions/pi-console-webui && npx --no-install next build",
    "ensure:nono": "sh scripts/install-nono.sh",
    "postinstall": "npm run ensure:nono && npm run build:web",
    "test": "npm run test:composio && npm run build:web",
    "test:composio": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@composio/core": "^0.18.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@fastify/websocket": "^11.3.0",
    "@homebridge/node-pty-prebuilt-multiarch": "^0.14.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@uiw/react-codemirror": "^4.25.11",
    "@uiw/react-md-editor": "^4.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.12.1",
    "ink": "^7.1.1",
    "jiti": "^2.7.0",
    "lucide-react": "^0.468.0",
    "next": "^15.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^3.4.17",
    "typebox": "^1.3.30",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/api-server",
      "./extensions/cli-resources.ts",
      "./extensions/composio",
      "./extensions/context-memory",
      "./extensions/guardrails",
      "./extensions/pi-console-webui",
      "./extensions/profiles.ts",
      "./extensions/pulse",
      "./extensions/sequential-workflow.ts",
      "./extensions/skill-sources"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/rjaskonis/pi-feats/v0.1.3/assets/pi-feats-preview.png"
  }
}
