# Pi Agent — Docker Compose / Dokploy environment
# Copy to .env or configure these variables in Dokploy.

# Compose/Docker identity. Keep values unique per Pi deployment on the same host.
PI_COMPOSE_PROJECT_NAME=pi-agent
PI_CONTAINER_NAME=pi-agent
PI_IMAGE=pi-agent:compose
PI_NETWORK_NAME=pi-agent-network

# Resolve the latest Pi CLI on every build, or pin an exact version.
PI_CLI_VERSION=latest
PI_BUILD_NO_CACHE=true

# pi-feats is the sole extension package. Pin PI_FEATS_REF to a release tag or
# commit SHA in production; main is convenient only for development.
PI_FEATS_REPOSITORY=https://github.com/rjaskonis/pi-feats.git
PI_FEATS_SOURCE=git:github.com/rjaskonis/pi-feats
PI_FEATS_REF=main

# Public Traefik/Dokploy routing.
PI_TRAEFIK_ENABLE=true
PI_TRAEFIK_ROUTER_PREFIX=pi-agent
PI_TRAEFIK_HOST=pi.example.com
PI_TRAEFIK_NETWORK=dokploy-network
# true in Dokploy/production (Traefik network already exists); false for local docker compose.
PI_TRAEFIK_NETWORK_EXTERNAL=true
PI_TRAEFIK_CERT_RESOLVER=letsencrypt
# Public HTTPS origin. The API uses this to generate WSS URLs for live adapter logs.
PI_PUBLIC_BASE_URL=https://pi.example.com

# Console authentication. Use a long unique password.
PI_CONSOLE_USERNAME=admin
PI_CONSOLE_PASSWORD=change-me
# Required behind HTTPS so the HttpOnly session cookie includes Secure.
PI_CONSOLE_HTTPS=1

# API authentication. Generate with: openssl rand -base64 48
PI_API_TOKEN=change-me-with-a-long-random-token
# Never leave this as * in production.
PI_API_CORS_ORIGIN=https://pi.example.com

# Internal Console-to-API route. Keep private; it is not the public URL.
PI_API_PROXY_TARGET=http://127.0.0.1:8767

# Persistent Pi agent data on the Docker host.
PI_DATA_PATH=./data
